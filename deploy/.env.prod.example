# =============================================================================
# deploy/.env.prod.example — template for /opt/mern-boilerplate/.env on the VPS.
# The real file is created by hand ONCE, chmod 600, owned by deploy, and its
# canonical copy lives in your password manager. It is never committed and
# CI never sees it. deploy.sh manages the APP_VERSION line.
#
# `make app-secrets` prints strong values for every `change-me` below.
# deploy.sh refuses to run while any `change-me` remains.
# =============================================================================
APP_VERSION=v0.0.0

# --- database (service name `mongo` on the compose network) ---
# The root user is created on the first start of an empty volume. The password
# in MONGODB_URI must be the same as MONGO_INITDB_ROOT_PASSWORD.
MONGO_INITDB_ROOT_USERNAME=mern
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGODB_URI=mongodb://mern:change-me@mongo:27017/mern_boilerplate?authSource=admin

# --- app ---
# Origins allowed to call the API: the public website hostnames, comma-separated.
# Required — the API refuses to start in production without it.
CORS_ORIGIN=https://change-me,https://www.change-me
# 32+ random characters each (the API refuses shorter ones in production).
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Shared by the API and the web container (on-demand cache invalidation).
REVALIDATE_SECRET=change-me
# Request-form token signing and IP hashing.
TICKET_TOKEN_SECRET=change-me
IP_HASH_SALT=change-me
DEFAULT_LOCALE=fa
MAX_UPLOAD_MB=5
# Proxies in front of the API. Keep 1 until deploy/Caddyfile lists the CDN
# ranges in `trusted_proxies`; then set 2 so rate limits see the visitor's IP.
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# --- dev-mode switches: MUST stay off in production ---
# Swagger UI at /docs.
DOCS_ENABLED=false

# --- first accounts ---
# Used once by `make seed-prod` after the first deploy. There are no defaults in
# production: the seed refuses to run until all four are set.
DEVELOPER_SEED_EMAIL=change-me
DEVELOPER_SEED_PASSWORD=change-me
ADMIN_SEED_EMAIL=change-me
ADMIN_SEED_PASSWORD=change-me
