# --- Runtime ---
# `make dev-api` overrides PORT, MONGODB_URI, CORS_ORIGIN and REVALIDATE_URL with the ports of this
# repo's PROJECT_SLOT (root .env). The values below apply to a plain `npm run dev`.
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Reverse proxies in front of the API (Express `trust proxy`).
TRUST_PROXY_HOPS=1
# Swagger UI at /docs. Defaults to on outside production, off in production.
# DOCS_ENABLED=true

# --- Database ---
# Local (outside Docker): mongodb://localhost:27017/ghahremani_bodystyle
# Inside docker-compose:  mongodb://mongo:27017/ghahremani_bodystyle
MONGODB_URI=mongodb://localhost:27017/ghahremani_bodystyle

# --- CORS ---
# Origin allowed to call this API (the Next.js frontend). Comma-separate for multiple.
# Required in production: the API refuses to start without it, and "*" is not accepted.
CORS_ORIGIN=http://localhost:3000

# --- Auth / JWT ---
# Use long, random values in real environments (e.g. `openssl rand -hex 32`). Production refuses
# secrets shorter than 32 chars or containing "change_me".
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
PASSWORD_MIN_LENGTH=10

# --- Anti-abuse (optional; derived from JWT_ACCESS_SECRET when empty) ---
TICKET_TOKEN_SECRET=
IP_HASH_SALT=

# --- Next.js on-demand revalidation (server → web) ---
# Inside docker-compose: http://web:3000
REVALIDATE_URL=http://localhost:3000
REVALIDATE_SECRET=dev_revalidate_secret_change_me

# --- Media ---
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=5

# --- Content ---
DEFAULT_LOCALE=fa

# --- Seed accounts (created by `npm run seed`) ---
# Demo credentials for development. Production has no defaults: the seed refuses to run without them.
DEVELOPER_SEED_EMAIL=developer@example.com
DEVELOPER_SEED_PASSWORD=developer123
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=changeme123
