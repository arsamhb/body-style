# Frontend (Next.js) environment. Copy to `.env.local` for local dev.
# `make dev-web` overrides the three URLs below with the ports of this repo's PROJECT_SLOT (root .env).
# The values here apply to a plain `npm run dev`.

# Base URL of the backend API, used by the browser-side axios client (inlined at build time).
NEXT_PUBLIC_BASE_URL=http://localhost:4000
# URL the Next.js server uses to reach the API (Docker: http://server:4000). Falls back to NEXT_PUBLIC_BASE_URL.
API_INTERNAL_URL=http://localhost:4000
# Canonical public URL of the site, for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Routing default locale (must be one of SUPPORTED_LOCALES in src/i18n/routing.ts).
NEXT_PUBLIC_DEFAULT_LOCALE=fa

# localStorage keys for the admin auth tokens (optional; defaults shown).
NEXT_PUBLIC_TOKEN_KEY_NAME=access
NEXT_PUBLIC_REFRESH_TOKEN_KEY_NAME=refresh
