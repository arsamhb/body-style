# Dev-stack variables. Copy to `.env` next to docker-compose.yml.

# Local port slot (see `make ports`). Every host port derives from it:
#   API 8000+N*100, web 3000+N*100 (native) / 3010+N*100 (compose),
#   mongo 27018+N
# Slot 5 → API 8500, web 3500 (native) / 3510 (compose), mongo 27023.
# A project cloned from this boilerplate takes the next free slot.
PROJECT_SLOT=5
# compose project name defaults to APP; override only if two checkouts of the
# same repo must run side by side
# COMPOSE_PROJECT_NAME=mern-boilerplate

# Generate secrets with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
REVALIDATE_SECRET=
TICKET_TOKEN_SECRET=
IP_HASH_SALT=

DEFAULT_LOCALE=fa

# Public URLs as seen from the browser. Leave unset: they follow the slot
# (http://localhost:<web compose port> and http://localhost:<API port>).
# PUBLIC_WEB_URL=
# PUBLIC_API_URL=

# First accounts (created by `make seed`). Dev-only demo credentials.
DEVELOPER_SEED_EMAIL=developer@example.com
DEVELOPER_SEED_PASSWORD=developer123
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=changeme123
